{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermCMD",
  "version": "0.1.0",
  "identifier": "com.termcmd.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TermCMD",
        "width": 1440,
        "height": 900,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agent Terminal Multiplexer & Desktop Canvas",
    "longDescription": "High-performance terminal canvas and orchestration manager for AI agents and human operators.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
